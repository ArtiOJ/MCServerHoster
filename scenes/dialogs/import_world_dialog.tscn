[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/dialogs/import_world_dialog.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/icons/archive.svg" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/folder.svg" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/stop.svg" id="4"]

[node name="ImportWorldDialog" type="ConfirmationDialog"]
title = "Import world"
size = Vector2i(640, 560)
min_size = Vector2i(600, 480)
ok_button_text = "Import"
dialog_hide_on_ok = false
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
offset_left = 16.0
offset_top = 12.0
offset_right = 624.0
offset_bottom = 504.0
theme_override_constants/separation = 12

[node name="Intro" type="Label" parent="VBox"]
custom_minimum_size = Vector2(580, 0)
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Import a Java Edition world: a downloaded map (.zip), a singleplayer save folder, or another server's world. Nether and End are converted to the layout this server expects."
autowrap_mode = 3

[node name="SourceRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ChooseZipButton" type="Button" parent="VBox/SourceRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Pick a world or map archive (.zip). It may contain the world folder at any depth."
text = "Choose .zip…"
icon = ExtResource("2")

[node name="ChooseFolderButton" type="Button" parent="VBox/SourceRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Pick a world folder (the one containing level.dat), e.g. from .minecraft/saves, or a folder that contains it."
text = "Choose folder…"
icon = ExtResource("3")

[node name="SourceLabel" type="Label" parent="VBox/SourceRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
text = "No world chosen"
text_overrun_behavior = 3

[node name="RunningNotice" type="PanelContainer" parent="VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"NoticePanel"

[node name="Row" type="HBoxContainer" parent="VBox/RunningNotice"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Label" type="Label" parent="VBox/RunningNotice/Row"]
layout_mode = 2
size_flags_horizontal = 3
text = "The server is running. Stop it before importing a world."
autowrap_mode = 3

[node name="StopButton" type="Button" parent="VBox/RunningNotice/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "Stop server"
icon = ExtResource("4")

[node name="AnalysisCard" type="PanelContainer" parent="VBox"]
