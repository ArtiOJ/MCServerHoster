[node name="Options" type="GridContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 10
columns = 2

[node name="ModeLabel" type="Label" parent="VBox/Options"]
layout_mode = 2
mouse_filter = 0
tooltip_text = "Replace: the current world is backed up to this server's Backups, then deleted and replaced.
Add: the world is added next to the current one and the server switches to it (the old world stays on disk).
Dimension (Minecraft 26+ only): one dimension of it is added to the current world as an extra dimension; players reach it with /execute in minecraft:<name> run tp @s <x y z>."
text = "Import as"

[node name="ModeOption" type="OptionButton" parent="VBox/Options"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Replace: the current world is backed up to this server's Backups, then deleted and replaced.
Add: the world is added next to the current one and the server switches to it (the old world stays on disk).
Dimension (Minecraft 26+ only): one dimension of it is added to the current world as an extra dimension; players reach it with /execute in minecraft:<name> run tp @s <x y z>."
selected = 0
item_count = 3
popup/item_0/text = "Replace current world"
popup/item_0/id = 0
popup/item_1/text = "Add as new world and switch to it"
popup/item_1/id = 1
popup/item_2/text = "Add as dimension of current world"
popup/item_2/id = 2

[node name="DimensionLabel" type="Label" parent="VBox/Options"]
unique_name_in_owner = true
visible = false
layout_mode = 2
mouse_filter = 0
tooltip_text = "Which of the world's dimensions to add. \"Older save\" ones come from a copy of the original world that the folder still carries."
text = "Dimension"

[node name="DimensionOption" type="OptionButton" parent="VBox/Options"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Which of the world's dimensions to add. \"Older save\" ones come from a copy of the original world that the folder still carries."

[node name="ApplyLabel" type="Label" parent="VBox/Options"]
layout_mode = 2
mouse_filter = 0
tooltip_text = "Set the server's game mode, difficulty and hardcore setting to the ones saved in the map (useful for adventure maps)."
text = "Use map settings"

[node name="ApplyCheck" type="CheckButton" parent="VBox/Options"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
tooltip_text = "Set the server's game mode, difficulty and hardcore setting to the ones saved in the map (useful for adventure maps)."

[node name="Progress" type="ProgressBar" parent="VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
indeterminate = true

[node name="StatusLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(580, 0)
layout_mode = 2
autowrap_mode = 3

[node name="ZipDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Choose a world archive"
size = Vector2i(820, 520)
ok_button_text = "Open"
file_mode = 0
access = 2
filters = PackedStringArray("*.zip ; World archives", "*.mcworld ; Bedrock worlds (not supported)")
use_native_dialog = true

[node name="FolderDialog" type="FileDialog" parent="."]
