[node name="ChooseButton" type="Button" parent="VBox/TopRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "PNG, JPEG, WebP, SVG, BMP and TGA open directly. GIF, AVIF, HEIC, ICO, TIFF, JPEG XL and PSD are converted with an installed tool such as ImageMagick (animations use their first frame). You can also drop an image onto this window."
