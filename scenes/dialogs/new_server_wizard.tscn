[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/dialogs/new_server_wizard.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/components/slider_field.tscn" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/refresh.svg" id="3"]

[sub_resource type="StyleBoxFlat" id="Style_bg"]
bg_color = Color(0.114, 0.133, 0.169, 1)

[sub_resource type="StyleBoxEmpty" id="Style_empty"]

[node name="NewServerWizard" type="Window"]
title = "New Server"
size = Vector2i(780, 640)
min_size = Vector2i(700, 580)
visible = false
transient = true
exclusive = true
script = ExtResource("1")

[node name="Background" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("Style_bg")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="StepLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardTitle"
text = "STEP 1 OF 5"

[node name="PageTitle" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Name your server"

[node name="Pages" type="TabContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_styles/panel = SubResource("Style_empty")
current_tab = 0
tabs_visible = false

[node name="Basics" type="VBoxContainer" parent="Margin/VBox/Pages"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="NameLabel" type="Label" parent="Margin/VBox/Pages/Basics"]
layout_mode = 2
text = "Display name"

[node name="NameRow" type="HBoxContainer" parent="Margin/VBox/Pages/Basics"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="NameEdit" type="LineEdit" parent="Margin/VBox/Pages/Basics/NameRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "e.g. Survival"
max_length = 40

[node name="ColorPicker" type="ColorPickerButton" parent="Margin/VBox/Pages/Basics/NameRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(56, 38)
layout_mode = 2
tooltip_text = "Accent colour used in the sidebar"
color = Color(0.247, 0.725, 0.498, 1)
edit_alpha = false

[node name="FolderLabel" type="Label" parent="Margin/VBox/Pages/Basics"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Folder:"
text_overrun_behavior = 3

[node name="Intro" type="Label" parent="Margin/VBox/Pages/Basics"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "The next steps pick the Minecraft version and resources. The manager downloads the matching Paper build from PaperMC, verifies its checksum and prepares the server folder for you."
autowrap_mode = 3

[node name="Version" type="VBoxContainer" parent="Margin/VBox/Pages"]
visible = false
layout_mode = 2
theme_override_constants/separation = 10

[node name="Toolbar" type="HBoxContainer" parent="Margin/VBox/Pages/Version"]
layout_mode = 2

[node name="ShowPreCheck" type="CheckButton" parent="Margin/VBox/Pages/Version/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Show pre-releases"

[node name="ReloadVersionsButton" type="Button" parent="Margin/VBox/Pages/Version/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "Reload"
icon = ExtResource("3")

[node name="VersionList" type="ItemList" parent="Margin/VBox/Pages/Version"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
max_columns = 4
same_column_width = true
fixed_column_width = 150

[node name="VersionDetails" type="Label" parent="Margin/VBox/Pages/Version"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 66)
layout_mode = 2
text = "Loading versions…"
autowrap_mode = 3

[node name="Resources" type="VBoxContainer" parent="Margin/VBox/Pages"]
visible = false
layout_mode = 2
theme_override_constants/separation = 18

[node name="RamField" parent="Margin/VBox/Pages/Resources" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
title = "Memory (Java heap)"
unit = 1
min_value = 1024.0
max_value = 16384.0
step = 256.0
hint = "4–6 GB suits most small servers. You can fine-tune CPU limits, Java and JVM flags later in the Resources tab."

[node name="PortRow" type="HBoxContainer" parent="Margin/VBox/Pages/Resources"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="PortLabel" type="Label" parent="Margin/VBox/Pages/Resources/PortRow"]
layout_mode = 2
text = "Port"

[node name="PortSpin" type="SpinBox" parent="Margin/VBox/Pages/Resources/PortRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
min_value = 1024.0
max_value = 65535.0
value = 25565.0

[node name="PortStatus" type="Label" parent="Margin/VBox/Pages/Resources/PortRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "✓ Available"

[node name="AutoStartCheck" type="CheckButton" parent="Margin/VBox/Pages/Resources"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Start automatically when Server Manager opens"

[node name="Gameplay" type="GridContainer" parent="Margin/VBox/Pages"]
visible = false
layout_mode = 2
theme_override_constants/h_separation = 18
theme_override_constants/v_separation = 12
columns = 2

[node name="GamemodeLabel" type="Label" parent="Margin/VBox/Pages/Gameplay"]
layout_mode = 2
text = "Game mode"

[node name="GamemodeOption" type="OptionButton" parent="Margin/VBox/Pages/Gameplay"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
selected = 0
item_count = 4
popup/item_0/text = "Survival"
popup/item_0/id = 0
popup/item_1/text = "Creative"
popup/item_1/id = 1
popup/item_2/text = "Adventure"
popup/item_2/id = 2
popup/item_3/text = "Spectator"
popup/item_3/id = 3

[node name="DifficultyLabel" type="Label" parent="Margin/VBox/Pages/Gameplay"]
layout_mode = 2
text = "Difficulty"

[node name="DifficultyOption" type="OptionButton" parent="Margin/VBox/Pages/Gameplay"]
unique_name_in_owner = true
layout_mode = 2
selected = 2
item_count = 4
popup/item_0/text = "Peaceful"
popup/item_0/id = 0
popup/item_1/text = "Easy"
popup/item_1/id = 1
popup/item_2/text = "Normal"
popup/item_2/id = 2
popup/item_3/text = "Hard"
popup/item_3/id = 3

[node name="WorldTypeLabel" type="Label" parent="Margin/VBox/Pages/Gameplay"]
layout_mode = 2
text = "World type"

[node name="WorldTypeOption" type="OptionButton" parent="Margin/VBox/Pages/Gameplay"]
unique_name_in_owner = true
layout_mode = 2
selected = 0
item_count = 4
popup/item_0/text = "Default"
popup/item_0/id = 0
popup/item_1/text = "Superflat"
popup/item_1/id = 1
popup/item_2/text = "Large biomes"
popup/item_2/id = 2
popup/item_3/text = "Amplified"
popup/item_3/id = 3

[node name="MaxPlayersLabel" type="Label" parent="Margin/VBox/Pages/Gameplay"]
layout_mode = 2
text = "Max players"

[node name="MaxPlayersSpin" type="SpinBox" parent="Margin/VBox/Pages/Gameplay"]
unique_name_in_owner = true
layout_mode = 2
min_value = 1.0
max_value = 500.0
value = 20.0

[node name="MotdLabel" type="Label" parent="Margin/VBox/Pages/Gameplay"]
layout_mode = 2
text = "MOTD"

[node name="MotdEdit" type="LineEdit" parent="Margin/VBox/Pages/Gameplay"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "A Minecraft Server"
max_length = 120

[node name="SeedLabel" type="Label" parent="Margin/VBox/Pages/Gameplay"]
layout_mode = 2
text = "World seed"

[node name="SeedEdit" type="LineEdit" parent="Margin/VBox/Pages/Gameplay"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Random"

[node name="OnlineModeLabel" type="Label" parent="Margin/VBox/Pages/Gameplay"]
layout_mode = 2
text = "Online mode"

[node name="OnlineModeCheck" type="CheckButton" parent="Margin/VBox/Pages/Gameplay"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
tooltip_text = "Verify player accounts with Mojang. Only disable this behind a proxy such as Velocity."
button_pressed = true
text = "Verify accounts"

[node name="WhitelistLabel" type="Label" parent="Margin/VBox/Pages/Gameplay"]
layout_mode = 2
text = "Whitelist"

[node name="WhitelistCheck" type="CheckButton" parent="Margin/VBox/Pages/Gameplay"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Only whitelisted players"

[node name="PvpLabel" type="Label" parent="Margin/VBox/Pages/Gameplay"]
layout_mode = 2
text = "PvP"

[node name="PvpCheck" type="CheckButton" parent="Margin/VBox/Pages/Gameplay"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
button_pressed = true
text = "Players can hurt each other"

[node name="HardcoreLabel" type="Label" parent="Margin/VBox/Pages/Gameplay"]
layout_mode = 2
text = "Hardcore"

[node name="HardcoreCheck" type="CheckButton" parent="Margin/VBox/Pages/Gameplay"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "One life only"

[node name="Review" type="VBoxContainer" parent="Margin/VBox/Pages"]
visible = false
layout_mode = 2
theme_override_constants/separation = 14

[node name="SummaryCard" type="PanelContainer" parent="Margin/VBox/Pages/Review"]
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="SummaryLabel" type="Label" parent="Margin/VBox/Pages/Review/SummaryCard"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/line_spacing = 6
text = "Summary"
autowrap_mode = 3

[node name="EulaText" type="Label" parent="Margin/VBox/Pages/Review"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Running a Minecraft server requires agreeing to Mojang's End User License Agreement. The manager writes eula=true for this server only after you accept below."
autowrap_mode = 3

[node name="EulaLink" type="LinkButton" parent="Margin/VBox/Pages/Review"]
layout_mode = 2
size_flags_horizontal = 0
text = "Read the Minecraft EULA (aka.ms/MinecraftEULA)"
uri = "https://aka.ms/MinecraftEULA"

[node name="EulaCheck" type="CheckBox" parent="Margin/VBox/Pages/Review"]
unique_name_in_owner = true
layout_mode = 2
text = "I have read and agree to the Minecraft EULA"

[node name="Install" type="VBoxContainer" parent="Margin/VBox/Pages"]
visible = false
layout_mode = 2
theme_override_constants/separation = 12
alignment = 1

[node name="InstallStatus" type="Label" parent="Margin/VBox/Pages/Install"]
unique_name_in_owner = true
layout_mode = 2
text = "Preparing…"
autowrap_mode = 3

[node name="InstallProgress" type="ProgressBar" parent="Margin/VBox/Pages/Install"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 22)
layout_mode = 2

[node name="InstallError" type="Label" parent="Margin/VBox/Pages/Install"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.5, 0.5, 1)
autowrap_mode = 3

[node name="StartNowCheck" type="CheckBox" parent="Margin/VBox/Pages/Install"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "Start the server when installation finishes"

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="CancelButton" type="Button" parent="Margin/VBox/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 36)
layout_mode = 2
text = "Cancel"

[node name="Spacer" type="Control" parent="Margin/VBox/Buttons"]
layout_mode = 2
size_flags_horizontal = 3

[node name="BackButton" type="Button" parent="Margin/VBox/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 36)
layout_mode = 2
text = "Back"

[node name="NextButton" type="Button" parent="Margin/VBox/Buttons"]
unique_name_in_owner = true
