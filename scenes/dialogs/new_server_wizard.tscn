[sub_resource type="StyleBoxFlat" id="Style_bg"]
bg_color = Color(0.114, 0.133, 0.169, 1)

[sub_resource type="StyleBoxEmpty" id="Style_empty"]

[node name="NewServerWizard" type="Window"]
title = "New Server"
size = Vector2i(780, 640)
min_size = Vector2i(700, 580)
visible = false
transient = true
exclusive = true
script = ExtResource("1")

[node name="Background" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("Style_bg")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="StepLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardTitle"
text = "STEP 1 OF 5"

[node name="PageTitle" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Name your server"

[node name="Pages" type="TabContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_styles/panel = SubResource("Style_empty")
current_tab = 0
tabs_visible = false

[node name="Basics" type="VBoxContainer" parent="Margin/VBox/Pages"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="NameLabel" type="Label" parent="Margin/VBox/Pages/Basics"]
layout_mode = 2
text = "Display name"

[node name="NameRow" type="HBoxContainer" parent="Margin/VBox/Pages/Basics"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="NameEdit" type="LineEdit" parent="Margin/VBox/Pages/Basics/NameRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "e.g. Survival"
max_length = 40

[node name="ColorPicker" type="ColorPickerButton" parent="Margin/VBox/Pages/Basics/NameRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(56, 38)
layout_mode = 2
tooltip_text = "Accent colour used in the sidebar"
color = Color(0.247, 0.725, 0.498, 1)
edit_alpha = false

[node name="IconView" parent="Margin/VBox/Pages/Basics/NameRow" instance=ExtResource("icon_view")]
unique_name_in_owner = true
custom_minimum_size = Vector2(38, 38)
layout_mode = 2
tooltip_text = "Optional server icon for Minecraft's server list. Click to choose and crop an image."
clickable = true

[node name="FolderLabel" type="Label" parent="Margin/VBox/Pages/Basics"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Folder:"
text_overrun_behavior = 3

[node name="Intro" type="Label" parent="Margin/VBox/Pages/Basics"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "The next steps pick the Minecraft version and resources. The manager downloads the matching Paper build from PaperMC, verifies its checksum and prepares the server folder for you."
autowrap_mode = 3

[node name="WorldSeparator" type="HSeparator" parent="Margin/VBox/Pages/Basics"]
layout_mode = 2

[node name="WorldLabel" type="Label" parent="Margin/VBox/Pages/Basics"]
layout_mode = 2
mouse_filter = 0
tooltip_text = "Optional. Use a downloaded map, a singleplayer save or another server's world instead of generating a new one. The world's Minecraft version is preselected on the next page, and its game mode and difficulty are applied."
text = "Start from an existing world"

[node name="WorldRow" type="HBoxContainer" parent="Margin/VBox/Pages/Basics"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="WorldZipButton" type="Button" parent="Margin/VBox/Pages/Basics/WorldRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Pick a world or map archive (.zip)."
text = "Choose .zip…"
icon = ExtResource("world_zip")

[node name="WorldFolderButton" type="Button" parent="Margin/VBox/Pages/Basics/WorldRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Pick a world folder (the one containing level.dat), e.g. from .minecraft/saves."
text = "Choose folder…"
icon = ExtResource("world_folder")

[node name="WorldInfo" type="Label" parent="Margin/VBox/Pages/Basics/WorldRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
text = "New world"
text_overrun_behavior = 3

[node name="WorldClearButton" type="Button" parent="Margin/VBox/Pages/Basics/WorldRow"]
unique_name_in_owner = true
visible = false
layout_mode = 2
