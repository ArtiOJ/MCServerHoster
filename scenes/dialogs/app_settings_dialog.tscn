[node name="SleepLabel" type="Label" parent="Scroll/VBox/PowerGrid"]
layout_mode = 2
mouse_filter = 0
tooltip_text = "What happens when the computer tries to sleep while servers run. A sleeping computer cannot run anything, so servers either keep it awake or are stopped cleanly first. Blocking sleep never stops the screen from turning off or locking."
text = "When the computer sleeps"

[node name="SleepOption" type="OptionButton" parent="Scroll/VBox/PowerGrid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Block while players are online: sleep is refused while anyone is playing; otherwise servers are stopped cleanly first.
Stop servers, then sleep: always stop cleanly, never block.
Block while any server runs: the computer stays awake while a server is running.
Let it sleep: servers freeze during sleep and continue after waking; players get disconnected."
selected = 0
item_count = 4
popup/item_0/text = "Block sleep while players are online"
popup/item_0/id = 0
popup/item_1/text = "Stop servers, then sleep"
popup/item_1/id = 1
popup/item_2/text = "Block sleep while any server runs"
popup/item_2/id = 2
popup/item_3/text = "Let it sleep (servers pause)"
popup/item_3/id = 3

[node name="WakeLabel" type="Label" parent="Scroll/VBox/PowerGrid"]
layout_mode = 2
mouse_filter = 0
tooltip_text = "Start the servers that were stopped for sleep again when the computer wakes up."
text = "Restart after wake"

[node name="WakeCheck" type="CheckButton" parent="Scroll/VBox/PowerGrid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
tooltip_text = "Start the servers that were stopped for sleep again when the computer wakes up."

[node name="ExitLabel" type="Label" parent="Scroll/VBox/PowerGrid"]
layout_mode = 2
tooltip_text = "What happens when you close the window while servers are running. Keep running minimizes the window (Linux has no tray icon support in Godot). Quit, leave servers running closes the app; servers keep going and are re-attached the next time it opens (events, sleep handling and start-on-connect pause while it is closed)."
text = "Closing the window"

[node name="ExitOption" type="OptionButton" parent="Scroll/VBox/PowerGrid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
selected = 0
item_count = 4
popup/item_0/text = "Ask every time"
popup/item_0/id = 0
popup/item_1/text = "Stop all servers, then quit"
popup/item_1/id = 1
popup/item_2/text = "Keep running (minimize window)"
popup/item_2/id = 2
popup/item_3/text = "Quit, leave servers running"
popup/item_3/id = 3

