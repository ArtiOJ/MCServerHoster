[node name="ModeLabel" type="Label" parent="VBox/Options"]
layout_mode = 2
mouse_filter = 0
tooltip_text = "Manage in place: the server stays where it is; only a .manager folder is added. Ports and RCON are written to server.properties when the manager starts it.
Copy: the whole folder is copied into the servers folder and the original is left untouched."
text = "Location"

[node name="ModeOption" type="OptionButton" parent="VBox/Options"]
unique_name_in_owner = true
layout_mode = 2
