[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/sidebar/sidebar.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/logo.svg" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/dashboard.svg" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/plus.svg" id="4"]
[ext_resource type="Texture2D" path="res://assets/icons/settings.svg" id="5"]

[node name="Sidebar" type="PanelContainer"]
custom_minimum_size = Vector2(264, 0)
theme_type_variation = &"SidebarPanel"
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Brand" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Logo" type="TextureRect" parent="VBox/Brand"]
custom_minimum_size = Vector2(36, 36)
layout_mode = 2
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5

[node name="Titles" type="VBoxContainer" parent="VBox/Brand"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="AppName" type="Label" parent="VBox/Brand/Titles"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Server Manager"

[node name="SummaryLabel" type="Label" parent="VBox/Brand/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 12
text = "0 of 0 running"

[node name="Spacer" type="Control" parent="VBox"]
custom_minimum_size = Vector2(0, 6)
layout_mode = 2

[node name="DashboardButton" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
theme_type_variation = &"SidebarItem"
toggle_mode = true
button_pressed = true
text = "Dashboard"
icon = ExtResource("3")
alignment = 0

[node name="Caption" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"SidebarCaption"
text = "SERVERS"

[node name="Scroll" type="ScrollContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ServerList" type="VBoxContainer" parent="VBox/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="EmptyLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "No servers yet."
horizontal_alignment = 1

[node name="NewServerButton" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentButton"
tooltip_text = "Create a new Paper server (Ctrl+N)"
text = "New Server"
icon = ExtResource("4")

[node name="SettingsButton" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Application preferences: servers folder, Java runtimes, defaults"
theme_type_variation = &"SidebarItem"
text = "Preferences"
icon = ExtResource("5")
alignment = 0
