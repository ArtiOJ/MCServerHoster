[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/components/graph_card.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/components/line_graph.tscn" id="2"]

[node name="GraphCard" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"CardPanel"
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CardTitle"
text = "GRAPH"

[node name="ValueLabel" type="Label" parent="VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
text = "—"

[node name="Graph" parent="VBox" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
