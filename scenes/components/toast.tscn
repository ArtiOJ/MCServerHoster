[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/components/toast.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/icons/close.svg" id="2"]

[node name="Toast" type="PanelContainer"]
custom_minimum_size = Vector2(340, 0)
theme_type_variation = &"ToastPanel"
script = ExtResource("1")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="MessageLabel" type="Label" parent="HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3

[node name="CloseButton" type="Button" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 0
tooltip_text = "Dismiss"
icon = ExtResource("2")
flat = true

[node name="LifeTimer" type="Timer" parent="."]
unique_name_in_owner = true
one_shot = true
