[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/components/stat_card.gd" id="1"]

[node name="StatCard" type="PanelContainer"]
custom_minimum_size = Vector2(180, 0)
size_flags_horizontal = 3
theme_type_variation = &"CardPanel"
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TitleRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Icon" type="TextureRect" parent="VBox/TitleRow"]
unique_name_in_owner = true
modulate = Color(0.545, 0.576, 0.639, 1)
layout_mode = 2
size_flags_vertical = 4
stretch_mode = 5

[node name="TitleLabel" type="Label" parent="VBox/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardTitle"
text = "TITLE"

[node name="ValueLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardValue"
text = "—"
text_overrun_behavior = 3

[node name="SubLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text_overrun_behavior = 3
