[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/components/player_list_panel.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/icons/plus.svg" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/trash.svg" id="3"]

[node name="PlayerListPanel" type="PanelContainer"]
custom_minimum_size = Vector2(210, 300)
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"CardPanel"
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SectionHeader"
text = "Players"

[node name="CountLabel" type="Label" parent="VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"Badge"
text = "0"

[node name="NameList" type="ItemList" parent="VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
size_flags_vertical = 3

[node name="SelectedRow" type="HBoxContainer" parent="VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="LevelCaption" type="Label" parent="VBox/SelectedRow"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 0
tooltip_text = "Permission level of the selected operator: 1 bypass spawn protection, 2 cheat commands and command blocks, 3 player management (kick, ban, op), 4 everything including stop. Changeable while the server is stopped; commands sent to a running server always use the server's default level (op-permission-level)."
theme_type_variation = &"MutedLabel"
text = "Level"

[node name="SelectedLevel" type="OptionButton" parent="VBox/SelectedRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Permission level of the selected operator: 1 bypass spawn protection, 2 cheat commands and command blocks, 3 player management (kick, ban, op), 4 everything including stop. Changeable while the server is stopped; commands sent to a running server always use the server's default level (op-permission-level)."
selected = 3
item_count = 4
popup/item_0/text = "1"
popup/item_0/id = 1
popup/item_1/text = "2"
popup/item_1/id = 2
popup/item_2/text = "3"
popup/item_2/id = 3
popup/item_3/text = "4"
popup/item_3/id = 4

[node name="AddRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="NameEdit" type="LineEdit" parent="VBox/AddRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Player name"
max_length = 16

[node name="LevelOption" type="OptionButton" parent="VBox/AddRow"]
unique_name_in_owner = true
visible = false
layout_mode = 2
tooltip_text = "Permission level for the new operator (1–4). Used while the server is stopped; a running server applies its default level (op-permission-level)."
selected = 3
item_count = 4
popup/item_0/text = "1"
popup/item_0/id = 1
popup/item_1/text = "2"
popup/item_1/id = 2
popup/item_2/text = "3"
popup/item_2/id = 3
popup/item_3/text = "4"
popup/item_3/id = 4

[node name="AddButton" type="Button" parent="VBox/AddRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Add"
icon = ExtResource("2")

[node name="ReasonEdit" type="LineEdit" parent="VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
tooltip_text = "Shown to the banned player when they try to join."
placeholder_text = "Reason (optional)"
max_length = 200

[node name="RemoveButton" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DangerButton"
text = "Remove selected"
icon = ExtResource("3")

[node name="StatusLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="HintLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
autowrap_mode = 3
