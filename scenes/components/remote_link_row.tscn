[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/components/remote_link_row.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/components/status_dot.tscn" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/refresh.svg" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/trash.svg" id="4"]
[ext_resource type="Texture2D" path="res://assets/icons/globe.svg" id="5"]

[node name="RemoteLinkRow" type="PanelContainer"]
theme_type_variation = &"CardPanel"
script = ExtResource("1")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Dot" parent="HBox" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2

[node name="Text" type="VBoxContainer" parent="HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="NameLabel" type="Label" parent="HBox/Text"]
unique_name_in_owner = true
layout_mode = 2
text = "Computer"

[node name="DetailLabel" type="Label" parent="HBox/Text"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="ConnectButton" type="Button" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "Reconnect"
icon = ExtResource("3")

[node name="AddressButton" type="Button" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Change the address used to reach this computer (e.g. its internet address or a domain name)"
text = "Address…"
icon = ExtResource("5")

[node name="RemoveButton" type="Button" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Forget this computer and its access key here. Its owner can also revoke the key on their side."
text = "Remove"
icon = ExtResource("4")
