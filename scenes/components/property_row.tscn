[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/components/property_row.gd" id="1"]

[node name="PropertyRow" type="HBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 20
script = ExtResource("1")

[node name="Info" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 1

[node name="TitleRow" type="HBoxContainer" parent="Info"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="NameLabel" type="Label" parent="Info/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Property"

[node name="ModifiedBadge" type="Label" parent="Info/TitleRow"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"Badge"
text = "modified"

[node name="DescLabel" type="Label" parent="Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="KeyLabel" type="Label" parent="Info"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 11
text = "key"

[node name="Editor" type="HBoxContainer" parent="."]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
size_flags_vertical = 4
alignment = 2

[node name="BoolEdit" type="CheckButton" parent="Editor"]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="IntEdit" type="SpinBox" parent="Editor"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
rounded = true
allow_greater = false
update_on_text_changed = true

[node name="EnumEdit" type="OptionButton" parent="Editor"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(240, 0)
layout_mode = 2

[node name="TextEdit" type="LineEdit" parent="Editor"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
placeholder_text = "(empty)"
