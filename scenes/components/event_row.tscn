[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/components/event_row.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/icons/chevron_down.svg" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/trash.svg" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/clock.svg" id="4"]

[node name="EventRow" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"CardPanel"
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Summary" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="EnabledCheck" type="CheckButton" parent="VBox/Summary"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Enabled. Disabled events are kept but never run."
button_pressed = true

[node name="Icon" type="TextureRect" parent="VBox/Summary"]
modulate = Color(0.545, 0.576, 0.639, 1)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("4")
stretch_mode = 5

[node name="Texts" type="VBoxContainer" parent="VBox/Summary"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="SummaryLabel" type="Label" parent="VBox/Summary/Texts"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "Event"
text_overrun_behavior = 3

[node name="NextRunLabel" type="Label" parent="VBox/Summary/Texts"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
theme_override_font_sizes/font_size = 12
text_overrun_behavior = 3

[node name="InvalidBadge" type="Label" parent="VBox/Summary"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Times must be written as HH:MM (24-hour), e.g. 18:00."
mouse_filter = 1
theme_type_variation = &"WarnBadge"
text = "Invalid time"

[node name="ExpandButton" type="Button" parent="VBox/Summary"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Edit this event"
icon = ExtResource("2")
flat = true

[node name="DeleteButton" type="Button" parent="VBox/Summary"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Delete this event"
theme_type_variation = &"DangerButton"
