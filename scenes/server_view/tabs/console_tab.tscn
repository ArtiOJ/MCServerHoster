[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/tabs/console_tab.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/icons/search.svg" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/trash.svg" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/copy.svg" id="4"]
[ext_resource type="Texture2D" path="res://assets/icons/send.svg" id="5"]

[node name="Console" type="MarginContainer"]
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16
script = ExtResource("1")
remote_ready = true

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Toolbar" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SearchEdit" type="LineEdit" parent="VBox/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Filter output…"
clear_button_enabled = true
right_icon = ExtResource("2")

[node name="FilterOption" type="OptionButton" parent="VBox/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Show only some kinds of lines"
selected = 0
item_count = 4
popup/item_0/text = "All output"
popup/item_0/id = 0
popup/item_1/text = "Warnings & errors"
popup/item_1/id = 1
popup/item_2/text = "Errors only"
popup/item_2/id = 2
popup/item_3/text = "Manager & commands"
popup/item_3/id = 3

[node name="AutoscrollCheck" type="CheckButton" parent="VBox/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "Auto-scroll"

[node name="CopyButton" type="Button" parent="VBox/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Copy visible lines"
icon = ExtResource("4")

[node name="ClearButton" type="Button" parent="VBox/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Clear console"
icon = ExtResource("3")

[node name="Output" type="RichTextLabel" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
focus_mode = 2
theme_type_variation = &"ConsoleOutput"
bbcode_enabled = true
scroll_following = true
context_menu_enabled = true
selection_enabled = true
deselect_on_focus_loss_enabled = false

[node name="OfflineHint" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "The server is offline. Start it to send commands."

[node name="InputRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Prompt" type="Label" parent="VBox/InputRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.322, 0.8, 0.565, 1)
theme_override_font_sizes/font_size = 16
text = "›"

[node name="CommandEdit" type="LineEdit" parent="VBox/InputRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ConsoleInput"
placeholder_text = "Type a command"
keep_editing_on_text_submit = true

[node name="SendButton" type="Button" parent="VBox/InputRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(90, 36)
layout_mode = 2
theme_type_variation = &"AccentButton"
text = "Send"
icon = ExtResource("5")
