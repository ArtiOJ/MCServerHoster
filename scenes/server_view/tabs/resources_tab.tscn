texture = ExtResource("5")
stretch_mode = 5

[node name="Title" type="Label" parent="VBox/Scroll/Content/JavaCard/VBox/Header"]
layout_mode = 2
theme_type_variation = &"SectionHeader"
text = "Java"

[node name="JavaInfo" type="Label" parent="VBox/Scroll/Content/JavaCard/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SubtitleLabel"
text = "— requires Java 21"

[node name="Grid" type="GridContainer" parent="VBox/Scroll/Content/JavaCard/VBox"]
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 10
columns = 2

[node name="RuntimeLabel" type="Label" parent="VBox/Scroll/Content/JavaCard/VBox/Grid"]
layout_mode = 2
text = "Runtime"

[node name="JavaOption" type="OptionButton" parent="VBox/Scroll/Content/JavaCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
fit_to_longest_item = false

[node name="PresetLabel" type="Label" parent="VBox/Scroll/Content/JavaCard/VBox/Grid"]
layout_mode = 2
text = "JVM flags preset"

[node name="PresetOption" type="OptionButton" parent="VBox/Scroll/Content/JavaCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Garbage-collector tuning. Paper's recommended flags come from the PaperMC download API."

[node name="ExtraArgsLabel" type="Label" parent="VBox/Scroll/Content/JavaCard/VBox/Grid"]
layout_mode = 2
text = "Extra JVM arguments"

[node name="ExtraArgsEdit" type="LineEdit" parent="VBox/Scroll/Content/JavaCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ConsoleInput"
placeholder_text = "e.g. -Dpaper.playerconnection.keepalive=60"

[node name="ServerArgsLabel" type="Label" parent="VBox/Scroll/Content/JavaCard/VBox/Grid"]
layout_mode = 2
text = "Extra server arguments"

[node name="ServerArgsEdit" type="LineEdit" parent="VBox/Scroll/Content/JavaCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ConsoleInput"
placeholder_text = "e.g. --forceUpgrade"

[node name="JavaWarning" type="Label" parent="VBox/Scroll/Content/JavaCard/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.949, 0.722, 0.294, 1)
autowrap_mode = 3

[node name="PreviewTitle" type="Label" parent="VBox/Scroll/Content/JavaCard/VBox"]
layout_mode = 2
theme_type_variation = &"CardTitle"
text = "LAUNCH COMMAND PREVIEW"

[node name="CommandPreview" type="CodeEdit" parent="VBox/Scroll/Content/JavaCard/VBox"]
unique_name_in_owner = true
