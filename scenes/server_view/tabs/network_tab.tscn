[node name="InternalIpValue" type="Label" parent="Scroll/Content/ForwardCard/VBox/ForwardGrid"]
unique_name_in_owner = true
layout_mode = 2
text = "—"

[node name="InternalPortKey" type="Label" parent="Scroll/Content/ForwardCard/VBox/ForwardGrid"]
layout_mode = 2
mouse_filter = 0
