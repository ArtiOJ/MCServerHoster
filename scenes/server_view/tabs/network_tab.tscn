[ext_resource type="Texture2D" path="res://assets/icons/settings.svg" id="7"]

[node name="Network" type="MarginContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16
script = ExtResource("1")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="AddressesCard" type="PanelContainer" parent="Scroll/Content"]
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="VBox" type="VBoxContainer" parent="Scroll/Content/AddressesCard"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Scroll/Content/AddressesCard/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Icon" type="TextureRect" parent="Scroll/Content/AddressesCard/VBox/Header"]
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("2")
stretch_mode = 5

[node name="Title" type="Label" parent="Scroll/Content/AddressesCard/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SectionHeader"
text = "Addresses"

[node name="RefreshButton" type="Button" parent="Scroll/Content/AddressesCard/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Look up your public address again. It comes from your router (UPnP) when possible, otherwise from api.ipify.org (a third-party service that sees your IP address)."
text = "Refresh"
icon = ExtResource("4")

[node name="Grid" type="GridContainer" parent="Scroll/Content/AddressesCard/VBox"]
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 10
columns = 3

[node name="LanKey" type="Label" parent="Scroll/Content/AddressesCard/VBox/Grid"]
layout_mode = 2
mouse_filter = 0
tooltip_text = "Only for players on your own Wi-Fi/LAN. Internet players can't use this address; they use the internet address below, and your router forwards them here."
theme_type_variation = &"MutedLabel"
text = "Home network"

[node name="LanValue" type="Label" parent="Scroll/Content/AddressesCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "—"

[node name="CopyLanButton" type="Button" parent="Scroll/Content/AddressesCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Copy"
icon = ExtResource("3")

[node name="PublicKey" type="Label" parent="Scroll/Content/AddressesCard/VBox/Grid"]
layout_mode = 2
mouse_filter = 0
tooltip_text = "Players outside your home network connect with this address, once the port is forwarded on your router."
theme_type_variation = &"MutedLabel"
text = "Internet"

[node name="PublicValue" type="Label" parent="Scroll/Content/AddressesCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "—"

[node name="CopyPublicButton" type="Button" parent="Scroll/Content/AddressesCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Copy"
icon = ExtResource("3")

[node name="AddressHint" type="Label" parent="Scroll/Content/AddressesCard/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="ForwardCard" type="PanelContainer" parent="Scroll/Content"]
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="VBox" type="VBoxContainer" parent="Scroll/Content/ForwardCard"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Scroll/Content/ForwardCard/VBox"]
layout_mode = 2
