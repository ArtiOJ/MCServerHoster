[node name="TestButton" type="Button" parent="Scroll/Content/AccessCard/VBox/TestRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Ask api.mcsrvstat.us (a third-party service) to connect to your public address and port, exactly like a player outside your network would. Results are cached for about a minute."
theme_type_variation = &"AccentButton"
text = "Test from the internet"
icon = ExtResource("6")

[node name="TestStatus" type="Label" parent="Scroll/Content/AccessCard/VBox/TestRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3

[node name="TestReasons" type="Label" parent="Scroll/Content/AccessCard/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
autowrap_mode = 3

[node name="TestHint" type="Label" parent="Scroll/Content/AccessCard/VBox"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "The test is done by api.mcsrvstat.us (third party) and cached for about a minute. It works while the server is running or asleep."
autowrap_mode = 3

[node name="WakePingNotice" type="PanelContainer" parent="Scroll/Content/AccessCard/VBox"]
unique_name_in_owner = true
visible = false
