[node name="Icon" type="TextureRect" parent="Scroll/Content/ForwardCard/VBox/Header"]
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("7")
stretch_mode = 5

[node name="Title" type="Label" parent="Scroll/Content/ForwardCard/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 0
tooltip_text = "Players on the internet connect to your public address; your router must pass those connections on to this computer. Set this up once in your router's admin page (often under Port Forwarding, Virtual Server or NAT)."
theme_type_variation = &"SectionHeader"
text = "Router port forwarding"

[node name="OpenRouterButton" type="Button" parent="Scroll/Content/ForwardCard/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Open your router's admin page in the browser."
text = "Open router page"

[node name="ForwardGrid" type="GridContainer" parent="Scroll/Content/ForwardCard/VBox"]
