[node name="UpnpRow" type="HBoxContainer" parent="Scroll/Content/AccessCard/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="UpnpLabel" type="Label" parent="Scroll/Content/AccessCard/VBox/UpnpRow"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 0
tooltip_text = "Ask your router (via UPnP) to forward this server's game port to this computer while the server is running or asleep. The forward is removed when the server stops. The RCON port is never forwarded."
text = "UPnP forwarding"

[node name="RetryUpnpButton" type="Button" parent="Scroll/Content/AccessCard/VBox/UpnpRow"]
unique_name_in_owner = true
visible = false
layout_mode = 2
tooltip_text = "Search for the router and try forwarding again."
text = "Retry"
icon = ExtResource("4")

[node name="UpnpCheck" type="CheckButton" parent="Scroll/Content/AccessCard/VBox/UpnpRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Ask your router (via UPnP) to forward this server's game port to this computer while the server is running or asleep. The forward is removed when the server stops. The RCON port is never forwarded."

[node name="UpnpStatus" type="Label" parent="Scroll/Content/AccessCard/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="Separator" type="HSeparator" parent="Scroll/Content/AccessCard/VBox"]
