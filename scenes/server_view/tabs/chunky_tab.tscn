suffix = "blocks"

[node name="EstimateLabel" type="Label" parent="Scroll/VBox/NewCard/VBox/Grid/RadiusRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"

[node name="Actions" type="HBoxContainer" parent="Scroll/VBox/NewCard/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="StartButton" type="Button" parent="Scroll/VBox/NewCard/VBox/Actions"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentButton"
text = "Start"
icon = ExtResource("4")

[node name="Spacer" type="Control" parent="Scroll/VBox/NewCard/VBox/Actions"]
layout_mode = 2
size_flags_horizontal = 3

[node name="TrimSideOption" type="OptionButton" parent="Scroll/VBox/NewCard/VBox/Actions"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Which chunks Trim deletes: those outside the shape above, or those inside it (inside needs coordinates as the centre)."
selected = 0
item_count = 2
popup/item_0/text = "Outside the area"
popup/item_0/id = 0
popup/item_1/text = "Inside the area"
popup/item_1/id = 1

[node name="TrimButton" type="Button" parent="Scroll/VBox/NewCard/VBox/Actions"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DangerButton"
tooltip_text = "Permanently delete the chunks outside (or inside) the area above, e.g. to shrink a world. A backup of the worlds is made first; restart the server afterwards."
text = "Trim…"
icon = ExtResource("5")

[node name="TrimDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Trim chunks"
ok_button_text = "Back up and trim"
dialog_autowrap = true
