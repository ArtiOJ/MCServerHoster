max_value = 30000000.0
value = 1000.0
suffix = "blocks"

[node name="RadiusZSpin" type="SpinBox" parent="Scroll/VBox/NewCard/VBox/Grid/RadiusRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
