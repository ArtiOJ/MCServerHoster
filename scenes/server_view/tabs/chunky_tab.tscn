[node name="ZSpin" type="SpinBox" parent="Scroll/VBox/NewCard/VBox/Grid/CenterRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
tooltip_text = "Z (block)"
min_value = -30000000.0
max_value = 30000000.0
prefix = "Z"

[node name="RadiusLabel" type="Label" parent="Scroll/VBox/NewCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 0
tooltip_text = "In blocks from the centre to the edge (a square of radius 1000 is 2000 × 2000 blocks)."
text = "Radius"

[node name="RadiusRow" type="HBoxContainer" parent="Scroll/VBox/NewCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="RadiusSpin" type="SpinBox" parent="Scroll/VBox/NewCard/VBox/Grid/RadiusRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(170, 0)
layout_mode = 2
tooltip_text = "In blocks from the centre to the edge (a square of radius 1000 is 2000 × 2000 blocks)."
