[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/tabs/overview_tab.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/components/stat_card.tscn" id="2"]
[ext_resource type="PackedScene" path="res://scenes/components/graph_card.tscn" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/activity.svg" id="4"]
[ext_resource type="Texture2D" path="res://assets/icons/users.svg" id="5"]
[ext_resource type="Texture2D" path="res://assets/icons/clock.svg" id="6"]
[ext_resource type="Texture2D" path="res://assets/icons/server.svg" id="7"]
[ext_resource type="Texture2D" path="res://assets/icons/copy.svg" id="8"]
[ext_resource type="Texture2D" path="res://assets/icons/folder.svg" id="9"]
[ext_resource type="PackedScene" path="res://scenes/components/server_icon_view.tscn" id="icon_view"]
[ext_resource type="PackedScene" path="res://scenes/dialogs/icon_editor_dialog.tscn" id="icon_editor"]

[node name="Overview" type="MarginContainer"]
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 18
script = ExtResource("1")
remote_ready = true

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="Notice" type="PanelContainer" parent="Scroll/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"NoticePanel"

[node name="NoticeLabel" type="Label" parent="Scroll/VBox/Notice"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="Cards" type="HBoxContainer" parent="Scroll/VBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="StatusCard" parent="Scroll/VBox/Cards" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
title = "Status"
icon = ExtResource("7")

[node name="PlayersCard" parent="Scroll/VBox/Cards" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
title = "Players"
icon = ExtResource("5")

[node name="TpsCard" parent="Scroll/VBox/Cards" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
title = "TPS"
icon = ExtResource("4")

[node name="UptimeCard" parent="Scroll/VBox/Cards" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
title = "Uptime"
icon = ExtResource("6")

[node name="Graphs" type="HBoxContainer" parent="Scroll/VBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="CpuGraph" parent="Scroll/VBox/Graphs" instance=ExtResource("3")]
unique_name_in_owner = true
layout_mode = 2
title = "CPU (share of host)"

[node name="RamGraph" parent="Scroll/VBox/Graphs" instance=ExtResource("3")]
unique_name_in_owner = true
layout_mode = 2
title = "Memory (resident)"
line_color = Color(0.353, 0.663, 0.949, 1)

[node name="Bottom" type="HBoxContainer" parent="Scroll/VBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="DetailsCard" type="PanelContainer" parent="Scroll/VBox/Bottom"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 2.0
theme_type_variation = &"CardPanel"

[node name="VBox" type="VBoxContainer" parent="Scroll/VBox/Bottom/DetailsCard"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox"]
layout_mode = 2
theme_type_variation = &"SectionHeader"
text = "Details"

[node name="IconRow" type="HBoxContainer" parent="Scroll/VBox/Bottom/DetailsCard/VBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="IconView" parent="Scroll/VBox/Bottom/DetailsCard/VBox/IconRow" instance=ExtResource("icon_view")]
unique_name_in_owner = true
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
tooltip_text = "Server icon shown in Minecraft's server list. Click to change it."
clickable = true

[node name="IconText" type="VBoxContainer" parent="Scroll/VBox/Bottom/DetailsCard/VBox/IconRow"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 6

[node name="IconStatus" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/IconRow/IconText"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "No icon"
autowrap_mode = 3

[node name="ChangeIconButton" type="Button" parent="Scroll/VBox/Bottom/DetailsCard/VBox/IconRow/IconText"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
tooltip_text = "Choose and crop an image for the server list. Any common image format works."
text = "Change icon…"

[node name="Grid" type="GridContainer" parent="Scroll/VBox/Bottom/DetailsCard/VBox"]
layout_mode = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 8
columns = 2

[node name="AddressKey" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Connect address"

[node name="AddressValue" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "—"

[node name="VersionKey" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Software"

[node name="VersionValue" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
text = "—"

[node name="JavaKey" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Java"

[node name="JavaValue" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
text = "—"

[node name="MemoryKey" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Memory"

[node name="MemoryValue" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
text = "—"

[node name="CpuKey" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "CPU"

[node name="CpuValue" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
text = "—"

[node name="FolderKey" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Folder"

[node name="FolderValue" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
text = "—"
text_overrun_behavior = 3

[node name="CreatedKey" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Created"

[node name="CreatedValue" type="Label" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Grid"]
unique_name_in_owner = true
layout_mode = 2
text = "—"

[node name="Buttons" type="HBoxContainer" parent="Scroll/VBox/Bottom/DetailsCard/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CopyAddressButton" type="Button" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Copy address"
icon = ExtResource("8")

[node name="OpenFolderButton" type="Button" parent="Scroll/VBox/Bottom/DetailsCard/VBox/Buttons"]
unique_name_in_owner = true
layout_mode = 2
text = "Open folder"
icon = ExtResource("9")

[node name="OnlineCard" type="PanelContainer" parent="Scroll/VBox/Bottom"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"CardPanel"

[node name="VBox" type="VBoxContainer" parent="Scroll/VBox/Bottom/OnlineCard"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Scroll/VBox/Bottom/OnlineCard/VBox"]
layout_mode = 2
theme_type_variation = &"SectionHeader"
text = "Online now"

[node name="OnlineEmpty" type="Label" parent="Scroll/VBox/Bottom/OnlineCard/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Server is offline."

[node name="OnlineList" type="ItemList" parent="Scroll/VBox/Bottom/OnlineCard/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 180)
layout_mode = 2
size_flags_vertical = 3

[node name="TickTimer" type="Timer" parent="."]
unique_name_in_owner = true

[node name="IconEditorDialog" parent="." instance=ExtResource("icon_editor")]
unique_name_in_owner = true
visible = false
