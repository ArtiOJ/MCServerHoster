[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/tabs/backups_tab.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/icons/archive.svg" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/save.svg" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/folder.svg" id="4"]
[ext_resource type="Texture2D" path="res://assets/icons/undo.svg" id="5"]
[ext_resource type="Texture2D" path="res://assets/icons/trash.svg" id="6"]
[ext_resource type="Texture2D" path="res://assets/icons/download.svg" id="7"]

[node name="Backups" type="MarginContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20
script = ExtResource("1")
remote_ready = true

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Toolbar" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BackupWorldButton" type="Button" parent="VBox/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentButton"
tooltip_text = "Zip the world folders (overworld, nether, end). Safe while the server is running."
text = "Back up world"
icon = ExtResource("2")

[node name="FullBackupButton" type="Button" parent="VBox/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Zip the whole server folder: worlds, plugins and configuration"
text = "Full backup"
icon = ExtResource("3")

[node name="OpenFolderButton" type="Button" parent="VBox/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "Open folder"
icon = ExtResource("4")

[node name="BackupProgress" type="ProgressBar" parent="VBox/Toolbar"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4

[node name="ListCard" type="PanelContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"CardPanel"

[node name="VBox" type="VBoxContainer" parent="VBox/ListCard"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="VBox/ListCard/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="VBox/ListCard/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SectionHeader"
text = "Backups"

[node name="RestoreHint" type="Label" parent="VBox/ListCard/VBox/Header"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Stop the server to restore"

[node name="SaveCopyButton" type="Button" parent="VBox/ListCard/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Save a copy of the selected backup on this computer"
disabled = true
text = "Save copy"
icon = ExtResource("7")

[node name="RestoreButton" type="Button" parent="VBox/ListCard/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Restore"
icon = ExtResource("5")

[node name="DeleteButton" type="Button" parent="VBox/ListCard/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DangerButton"
disabled = true
text = "Delete"
icon = ExtResource("6")

[node name="BackupTree" type="Tree" parent="VBox/ListCard/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
columns = 4
column_titles_visible = true
hide_root = true
select_mode = 1

[node name="SummaryLabel" type="Label" parent="VBox/ListCard/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text_overrun_behavior = 3

[node name="RestoreDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Restore backup"
size = Vector2i(460, 180)
ok_button_text = "Restore"
dialog_autowrap = true

[node name="DeleteDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Delete backup"
ok_button_text = "Delete"
dialog_autowrap = true

[node name="SaveDialog" type="FileDialog" parent="."]
unique_name_in_owner = true
title = "Save backup"
size = Vector2i(820, 520)
access = 2
filters = PackedStringArray("*.zip ; Zip archives")
use_native_dialog = true
