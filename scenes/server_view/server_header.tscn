[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/server_view/server_header.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/icons/play.svg" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/stop.svg" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/restart.svg" id="4"]
[ext_resource type="Texture2D" path="res://assets/icons/kill.svg" id="5"]
[ext_resource type="Texture2D" path="res://assets/icons/more.svg" id="6"]
[ext_resource type="Texture2D" path="res://assets/icons/download.svg" id="7"]
[ext_resource type="Texture2D" path="res://assets/icons/chevron_down.svg" id="8"]

[node name="ServerHeader" type="PanelContainer"]
theme_type_variation = &"HeaderPanel"
script = ExtResource("1")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ColorBar" type="ColorRect" parent="HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(4, 44)
layout_mode = 2
size_flags_vertical = 4
color = Color(0.247, 0.725, 0.498, 1)

[node name="Titles" type="VBoxContainer" parent="HBox"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 2

[node name="NameRow" type="HBoxContainer" parent="HBox/Titles"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="NameLabel" type="Label" parent="HBox/Titles/NameRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Server"

[node name="StateBadge" type="Label" parent="HBox/Titles/NameRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"Badge"
text = "STOPPED"

[node name="TempBadge" type="Label" parent="HBox/Titles/NameRow"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "This server runs from a throwaway copy of its folder. When it stops you choose whether to keep or discard what changed."
mouse_filter = 0
theme_type_variation = &"WarnBadge"
text = "TEMPORARY COPY"

[node name="UpdateButton" type="Button" parent="HBox/Titles/NameRow"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "A newer Paper build is available for this Minecraft version"
theme_override_font_sizes/font_size = 12
text = "Update available"
icon = ExtResource("7")
flat = true

[node name="InfoLabel" type="Label" parent="HBox/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SubtitleLabel"
text = "Paper"
text_overrun_behavior = 3

[node name="StartButton" type="Button" parent="HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 36)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Start the server (Ctrl+Enter)"
theme_type_variation = &"AccentButton"
text = "Start"
icon = ExtResource("2")

[node name="StartMenuButton" type="MenuButton" parent="HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(28, 36)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Start options"
icon = ExtResource("8")
icon_alignment = 1
item_count = 2
popup/item_0/text = "Start"
popup/item_0/id = 0
popup/item_1/text = "Start temporary copy"
popup/item_1/id = 1

[node name="StopButton" type="Button" parent="HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 36)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Save worlds and stop gracefully (Ctrl+Enter)"
text = "Stop"
icon = ExtResource("3")

[node name="RestartButton" type="Button" parent="HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Restart"
icon = ExtResource("4")

[node name="KillButton" type="Button" parent="HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Force kill the process (unsaved progress is lost)"
theme_type_variation = &"DangerButton"
icon = ExtResource("5")

[node name="MoreButton" type="MenuButton" parent="HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 36)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "More actions"
icon = ExtResource("6")
icon_alignment = 1
item_count = 11
popup/item_0/text = "Open server folder"
popup/item_0/id = 0
popup/item_1/text = "Copy connect address"
popup/item_1/id = 1
popup/item_2/text = "Update / change version…"
popup/item_2/id = 2
popup/item_3/text = "Check for Paper updates"
popup/item_3/id = 3
popup/item_4/text = "Stop leftover process"
popup/item_4/id = 4
popup/item_5/text = "Clear console"
popup/item_5/id = 5
popup/item_6/text = "Duplicate…"
popup/item_6/id = 7
popup/item_7/text = "Import world…"
popup/item_7/id = 9
popup/item_8/text = "Keep or discard temporary copy…"
popup/item_8/id = 8
popup/item_9/id = 100
popup/item_9/separator = true
popup/item_10/text = "Delete server…"
popup/item_10/id = 6
