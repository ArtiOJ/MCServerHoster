[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/dashboard/dashboard.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/components/stat_card.tscn" id="2"]
[ext_resource type="PackedScene" path="res://scenes/components/graph_card.tscn" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/server.svg" id="4"]
[ext_resource type="Texture2D" path="res://assets/icons/cpu.svg" id="5"]
[ext_resource type="Texture2D" path="res://assets/icons/memory.svg" id="6"]
[ext_resource type="Texture2D" path="res://assets/icons/sliders.svg" id="7"]
[ext_resource type="Texture2D" path="res://assets/icons/play.svg" id="8"]
[ext_resource type="Texture2D" path="res://assets/icons/stop.svg" id="9"]
[ext_resource type="Texture2D" path="res://assets/icons/plus.svg" id="10"]
[ext_resource type="Texture2D" path="res://assets/logo.svg" id="11"]
[ext_resource type="Texture2D" path="res://assets/icons/upload.svg" id="12"]

[node name="Dashboard" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24
script = ExtResource("1")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 18

[node name="Header" type="HBoxContainer" parent="Scroll/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Titles" type="VBoxContainer" parent="Scroll/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Scroll/VBox/Header/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Dashboard"

[node name="Subtitle" type="Label" parent="Scroll/VBox/Header/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SubtitleLabel"
text = "All Minecraft servers hosted on this machine"

[node name="StartAllButton" type="Button" parent="Scroll/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "Start all"
icon = ExtResource("8")

[node name="StopAllButton" type="Button" parent="Scroll/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "Stop all"
icon = ExtResource("9")

[node name="HostCards" type="HBoxContainer" parent="Scroll/VBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="RunningCard" parent="Scroll/VBox/HostCards" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
title = "Servers"
icon = ExtResource("4")

[node name="HostCpuCard" parent="Scroll/VBox/HostCards" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
title = "Host CPU"
icon = ExtResource("5")

[node name="HostRamCard" parent="Scroll/VBox/HostCards" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
title = "Host memory"
icon = ExtResource("6")

[node name="AllocatedCard" parent="Scroll/VBox/HostCards" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2
title = "Allocated"
icon = ExtResource("7")

[node name="Graphs" type="HBoxContainer" parent="Scroll/VBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="HostCpuGraph" parent="Scroll/VBox/Graphs" instance=ExtResource("3")]
unique_name_in_owner = true
layout_mode = 2
title = "Host CPU"

[node name="HostRamGraph" parent="Scroll/VBox/Graphs" instance=ExtResource("3")]
unique_name_in_owner = true
layout_mode = 2
title = "Host memory (GB)"
line_color = Color(0.353, 0.663, 0.949, 1)

[node name="ServersTitle" type="Label" parent="Scroll/VBox"]
layout_mode = 2
theme_type_variation = &"SectionHeader"
text = "Servers"

[node name="EmptyState" type="PanelContainer" parent="Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="VBox" type="VBoxContainer" parent="Scroll/VBox/EmptyState"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Logo" type="TextureRect" parent="Scroll/VBox/EmptyState/VBox"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_horizontal = 4
texture = ExtResource("11")
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="Scroll/VBox/EmptyState/VBox"]
layout_mode = 2
theme_type_variation = &"SectionHeader"
text = "No servers yet"
horizontal_alignment = 1

[node name="Body" type="Label" parent="Scroll/VBox/EmptyState/VBox"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Create your first Paper server. The manager downloads the right build, picks a compatible Java runtime and sets everything up."
horizontal_alignment = 1
autowrap_mode = 3

[node name="EmptyButtons" type="HBoxContainer" parent="Scroll/VBox/EmptyState/VBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/separation = 10

[node name="CreateButton" type="Button" parent="Scroll/VBox/EmptyState/VBox/EmptyButtons"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentButton"
text = "Create a server"
icon = ExtResource("10")

[node name="ImportButton" type="Button" parent="Scroll/VBox/EmptyState/VBox/EmptyButtons"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Add a server you already have from any folder"
text = "Import an existing server"
icon = ExtResource("12")

[node name="Cards" type="HFlowContainer" parent="Scroll/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14

[node name="HostTimer" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 2.0
autostart = true
