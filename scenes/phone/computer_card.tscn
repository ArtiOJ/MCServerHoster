[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/phone/computer_card.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/components/status_dot.tscn" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/sun.svg" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/more.svg" id="4"]

[node name="ComputerCard" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"CardPanel"
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Head" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Dot" parent="VBox/Head" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2

[node name="Text" type="VBoxContainer" parent="VBox/Head"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="NameLabel" type="Label" parent="VBox/Head/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SubtitleLabel"
text = "Computer"
text_overrun_behavior = 3

[node name="DetailLabel" type="Label" parent="VBox/Head/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="WakeButton" type="Button" parent="VBox/Head"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Wake the computer from sleep, so you can reach it and its servers"
focus_mode = 0
theme_type_variation = &"AccentButton"
text = "Wake"
icon = ExtResource("3")

[node name="MenuButton" type="MenuButton" parent="VBox/Head"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "More for this computer"
icon = ExtResource("4")
icon_alignment = 1
flat = false

[node name="ServerList" type="VBoxContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="EmptyLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"MutedLabel"
autowrap_mode = 3
