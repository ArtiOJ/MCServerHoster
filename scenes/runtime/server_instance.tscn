[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/runtime/server_instance.gd" id="1"]
[ext_resource type="Script" path="res://scripts/runtime/server_process.gd" id="2"]
[ext_resource type="Script" path="res://scripts/runtime/resource_monitor.gd" id="3"]
[ext_resource type="Script" path="res://scripts/runtime/rcon_client.gd" id="4"]
[ext_resource type="Script" path="res://scripts/runtime/task_scheduler.gd" id="5"]
[ext_resource type="Script" path="res://scripts/runtime/backup_service.gd" id="6"]

[node name="ServerInstance" type="Node"]
script = ExtResource("1")

[node name="ServerProcess" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("2")

[node name="PollTimer" type="Timer" parent="ServerProcess"]
unique_name_in_owner = true
wait_time = 0.05

[node name="ResourceMonitor" type="Timer" parent="."]
unique_name_in_owner = true
script = ExtResource("3")

[node name="RconClient" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("4")

[node name="RetryTimer" type="Timer" parent="RconClient"]
unique_name_in_owner = true
one_shot = true

[node name="TaskScheduler" type="Timer" parent="."]
unique_name_in_owner = true
script = ExtResource("5")

[node name="BackupService" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("6")

[node name="StopTimeoutTimer" type="Timer" parent="."]
unique_name_in_owner = true
one_shot = true

[node name="RestartDelayTimer" type="Timer" parent="."]
unique_name_in_owner = true
one_shot = true

[node name="QueryTimer" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 5.0
