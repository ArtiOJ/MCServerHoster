; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Server Manager"
config/description="Install, configure, run and monitor local Paper Minecraft servers."
config/version="0.1.0"
run/main_scene="res://scenes/main/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true
run/low_processor_mode.ios=false
config/icon="res://icon.svg"
run/main_scene.mobile="res://scenes/phone/phone_main.tscn"

[autoload]

AppSettings="*res://scripts/autoload/app_settings.gd"
JavaRuntimes="*res://scripts/autoload/java_runtimes.gd"
PaperApi="*res://scripts/autoload/paper_api.gd"
Notifier="*res://scripts/autoload/notifier.gd"
ServerManager="*res://scripts/autoload/server_manager.gd"
PowerManager="*res://scenes/runtime/power_manager.tscn"
NetworkService="*res://scenes/runtime/network_service.tscn"
RemoteAccess="*res://scripts/autoload/remote_access.gd"
RemoteHosts="*res://scripts/autoload/remote_hosts.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/energy_saving/keep_screen_on=false
window/handheld/orientation=1

[gui]

theme/custom="res://themes/main_theme.tres"

[input]

ui_console_focus={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":96,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
server_new={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":78,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
server_start_stop={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
server_next={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194306,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

textures/vram_compression/import_etc2_astc=true
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[shader_globals]

bm_distance={
"type": "float",
"value": 100.0
}
bm_sunlight={
"type": "float",
"value": 1.0
}
bm_ambient={
"type": "float",
"value": 0.0
}
bm_void_color={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
bm_hires_mask={
"type": "sampler2D",
"value": ""
}
bm_hires_origin={
"type": "vec2",
"value": Vector2(0, 0)
}
bm_hires_mask_size={
"type": "float",
"value": 0.0
}
bm_hires_translate={
"type": "vec2",
"value": Vector2(2, 2)
}
bm_hires_tile_size={
"type": "float",
"value": 32.0
}
bm_flat={
"type": "bool",
"value": false
}
