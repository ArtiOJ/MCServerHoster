static var _all: Array[Dictionary] = []
static var _by_id := {}


static func all() -> Array[Dictionary]:
	if _all.is_empty():
		_build()
	return _all


static func get_entry(id: String) -> Dictionary:
	if _all.is_empty():
		_build()
	return _by_id.get(id, {})


## Entries that exist in [param mc_version] ("" = assume the newest).
static func for_version(mc_version: String) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for e in all():
		if applies_to(e, mc_version):
			out.append(e)
	return out


static func applies_to(entry: Dictionary, mc_version: String) -> bool:
	if mc_version == "":
		return not entry.has("until")
	if entry.get("since", "") != "" and Fmt.compare_versions(mc_version, entry.since) < 0:
		return false
	if entry.has("until") and Fmt.compare_versions(mc_version, entry.until) >= 0:
		return false
	return true


## Console name of a game rule in [param mc_version].
static func rule_name(entry: Dictionary, mc_version: String) -> String:
	if mc_version != "" and Fmt.compare_versions(mc_version, SNAKE_CASE_RULES_SINCE) < 0:
		return entry.legacy
	return entry.key


## Console commands that set a game rule in every dimension.
static func rule_commands(entry: Dictionary, value: String, mc_version: String) -> PackedStringArray:
	var name := rule_name(entry, mc_version)
	if mc_version != "" and Fmt.compare_versions(mc_version, EXECUTE_IN_SINCE) < 0:
		return PackedStringArray(["gamerule %s %s" % [name, value]])
	var cmds := PackedStringArray()
	for dim in ["overworld", "the_nether", "the_end"]:
		cmds.append("execute in minecraft:%s run gamerule %s %s" % [dim, name, value])
	return cmds


## Short tag describing where a setting is stored (shown next to its name).
static func source_tag(entry: Dictionary) -> String:
	match entry.source:
		"yaml":
			return {BUKKIT: "bukkit", SPIGOT: "spigot", PAPER_GLOBAL: "paper", PAPER_WORLD: "paper"}.get(entry.file, "yaml")
		"gamerule":
			return "game rule"
	return ""


## Human-readable location for tooltips, e.g. "config/paper-world-defaults.yml → misc.redstone-implementation".
static func location(entry: Dictionary) -> String:
	match entry.source:
		"yaml":
			return "%s → %s" % [entry.file, entry.key]
		"gamerule":
			return "game rule %s" % entry.key
	return "server.properties → %s" % entry.key


## Entry for a server.properties key the catalog does not know (shown under "Other").
static func unknown_property_entry(key: String, value: String) -> Dictionary:
	return {
		"id": key, "source": "property", "key": key, "label": key, "desc": "",
		"type": PropertySchema.infer_type(key, value), "category": "Other", "default": "",
	}


static func _build() -> void:
	_all.clear()
	_by_id.clear()
	for key in PropertySchema.KEYS:
		var info: Dictionary = PropertySchema.KEYS[key]
		var e := info.duplicate()
		e.id = key
		e.source = "property"
		e.key = key
		e.default = str(info.get("default", ""))
		var cat: String = PROPERTY_CATEGORY_OVERRIDES.get(key, info.category)
		e.category = PROPERTY_CATEGORY_RENAMES.get(cat, cat)
		e.main = MAIN_IDS.has(key)
		_add(e)
	for g in GAME_RULES:
		var e := {
			"id": "gamerule." + g[0], "source": "gamerule", "key": g[0], "legacy": g[1], "type": g[2],
			"default": g[3], "category": g[4], "label": g[5], "desc": g[6], "since": g[7],
		}
		e.merge(g[8])
		_add(e)
	for y in YAML_SETTINGS:
		var e := {
			"id": "%s::%s" % [y[0], y[1]], "source": "yaml", "file": y[0], "key": y[1], "type": y[2],
			"default": y[3], "category": y[4], "label": y[5], "desc": y[6],
		}
		if y[0] == PAPER_GLOBAL or y[0] == PAPER_WORLD:
			e.since = PAPER_CONFIG_SINCE
		e.merge(y[7])
		_add(e)


static func _add(e: Dictionary) -> void:
	_all.append(e)
	_by_id[e.id] = e
